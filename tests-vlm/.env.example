# Copy file này thành .env rồi điền API key của model đã chọn.
# Sơ đồ biến đúng theo @midscene/web v1.10.3 (MIDSCENE_MODEL_* + MIDSCENE_MODEL_FAMILY).
# Quyết định chọn model + bảng giá: xem docs/pilot-model-cost.md

# ===== PHƯƠNG ÁN CHÍNH: Qwen3-VL (khuyến nghị theo docs Midscene) =====
# Qua OpenRouter (1 key dùng được nhiều model, dễ đăng ký):
MIDSCENE_MODEL_BASE_URL=https://openrouter.ai/api/v1
MIDSCENE_MODEL_API_KEY=
# Model ID pinned after the real pilot run (2026-07-08). Open-weight flagship.
# NOTE: OpenRouter does NOT list "qwen3-vl-plus" (proprietary, DashScope only).
MIDSCENE_MODEL_NAME=qwen/qwen3-vl-235b-a22b-instruct
MIDSCENE_MODEL_FAMILY=qwen3-vl

# Hoặc qua Alibaba DashScope international:
# MIDSCENE_MODEL_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# MIDSCENE_MODEL_NAME=qwen3-vl-plus
# MIDSCENE_MODEL_FAMILY=qwen3-vl

# ===== PHƯƠNG ÁN SO SÁNH/DỰ PHÒNG =====
# UI-TARS 1.5 (rẻ nhất, chuyên GUI, qua OpenRouter):
# MIDSCENE_MODEL_NAME=bytedance/ui-tars-1.5-7b
# MIDSCENE_MODEL_FAMILY=vlm-ui-tars
# Gemini (grounding tốt theo đánh giá docs Midscene):
# MIDSCENE_MODEL_FAMILY=gemini

# LƯU Ý: GPT-4o/GPT-5 bị docs Midscene đánh giá kém về UI localization — không dùng làm
# grounding model. Claude không được Midscene hỗ trợ chính thức.

# ===== CÀI ĐẶT CHO THỰC NGHIỆM (quan trọng, giữ nguyên) =====
# KHÔNG bật MIDSCENE_CACHE — cache làm sai lệch số liệu flakiness khi chạy lặp
MIDSCENE_MODEL_TEMPERATURE=0
